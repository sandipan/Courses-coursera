{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "claude-summarizer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "containers": [
    {
      "class_name": "SummarizerContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUMMARIZER",
        "class_name": "SummarizerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SummarizerContainer"]
    }
  ]
}