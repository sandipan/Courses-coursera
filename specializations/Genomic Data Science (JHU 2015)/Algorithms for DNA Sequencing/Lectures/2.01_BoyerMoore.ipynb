<div class="inner_cell">
    <div class="input_area">
<div class=" highlight hl-ipython2"><pre><span class="n">boyer_moore</span><span class="p">(</span><span class="n">p</span><span class="p">,</span> <span class="n">p_bm</span><span class="p">,</span> <span class="n">t</span><span class="p">)</span>
</pre></div>

</div>
</div>
