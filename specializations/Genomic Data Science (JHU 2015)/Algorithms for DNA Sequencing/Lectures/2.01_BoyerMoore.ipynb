</div>

</div>
<div class="cell border-box-sizing code_cell rendered">
<div class="input">
<div class="prompt input_prompt">In&nbsp;[3]:</div>
<div class="inner_cell">
    <div class="input_area">
<div class=" highlight hl-ipython2"><pre><span class="c"># GCTAGCTCTACGAGTCTA</span>
<span class="c"># ACTA</span>
<span class="n">p</span> <span class="o">=</span> <span class="s">&#39;ACTA&#39;</span>
<span class="n">p_bm</span> <span class="o">=</span> <span class="n">BoyerMoore</span><span class="p">(</span><span class="n">p</span><span class="p">,</span> <span class="n">alphabet</span><span class="o">=</span><span class="s">&#39;ACGT&#39;</span><span class="p">)</span>
<span class="n">p_bm</span><span class="o">.</span><span class="n">good_suffix_rule</span><span class="p">(</span><span class="mi">0</span><span class="p">)</span>
</pre></div>

</div>
</div>
</div>

<div class="output_wrapper">
