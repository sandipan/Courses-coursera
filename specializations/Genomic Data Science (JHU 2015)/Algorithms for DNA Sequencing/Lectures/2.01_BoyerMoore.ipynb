<div class="cell border-box-sizing code_cell rendered">
<div class="input">
<div class="prompt input_prompt">In&nbsp;[4]:</div>
<div class="inner_cell">
    <div class="input_area">
<div class=" highlight hl-ipython2"><pre><span class="c"># ACACGCTCTACGAGTCTA</span>
<span class="c"># ACAC</span>
<span class="n">p</span> <span class="o">=</span> <span class="s">&#39;ACAC&#39;</span>
<span class="n">p_bm</span> <span class="o">=</span> <span class="n">BoyerMoore</span><span class="p">(</span><span class="n">p</span><span class="p">,</span> <span class="n">alphabet</span><span class="o">=</span><span class="s">&#39;ACGT&#39;</span><span class="p">)</span>
<span class="n">p_bm</span><span class="o">.</span><span class="n">match_skip</span><span class="p">()</span>
</pre></div>

</div>
</div>
</div>

<div class="output_wrapper">
<div class="output">


<div class="output_area"><div class="prompt output_prompt">Out[4]:</div>


<div class="output_text output_subarea output_execute_result">
<pre>2</pre>
</div>

</div>

</div>
</div>

</div>
<div class="cell border-box-sizing code_cell rendered">
<div class="input">
<div class="prompt input_prompt">In&nbsp;[5]:</div>
<div class="inner_cell">
    <div class="input_area">
<div class=" highlight hl-ipython2"><pre><span class="k">def</span> <span class="nf">boyer_moore</span><span class="p">(</span><span class="n">p</span><span class="p">,</span> <span class="n">p_bm</span><span class="p">,</span> <span class="n">t</span><span class="p">):</span>
    <span class="sd">&quot;&quot;&quot; Do Boyer-Moore matching &quot;&quot;&quot;</span>
    <span class="n">i</span> <span class="o">=</span> <span class="mi">0</span>
    <span class="n">occurrences</span> <span class="o">=</span> <span class="p">[]</span>
    <span class="k">while</span> <span class="n">i</span> <span class="o">&lt;</span> <span class="nb">len</span><span class="p">(</span><span class="n">t</span><span class="p">)</span> <span class="o">-</span> <span class="nb">len</span><span class="p">(</span><span class="n">p</span><span class="p">)</span> <span class="o">+</span> <span class="mi">1</span><span class="p">:</span>
        <span class="n">shift</span> <span class="o">=</span> <span class="mi">1</span>
        <span class="n">mismatched</span> <span class="o">=</span> <span class="bp">False</span>
        <span class="k">for</span> <span class="n">j</span> <span class="ow">in</span> <span class="nb">xrange</span><span class="p">(</span><span class="nb">len</span><span class="p">(</span><span class="n">p</span><span class="p">)</span><span class="o">-</span><span class="mi">1</span><span class="p">,</span> <span class="o">-</span><span class="mi">1</span><span class="p">,</span> <span class="o">-</span><span class="mi">1</span><span class="p">):</span>
            <span class="k">if</span> <span class="n">p</span><span class="p">[</span><span class="n">j</span><span class="p">]</span> <span class="o">!=</span> <span class="n">t</span><span class="p">[</span><span class="n">i</span><span class="o">+</span><span class="n">j</span><span class="p">]:</span>
                <span class="n">skip_bc</span> <span class="o">=</span> <span class="n">p_bm</span><span class="o">.</span><span class="n">bad_character_rule</span><span class="p">(</span><span class="n">j</span><span class="p">,</span> <span class="n">t</span><span class="p">[</span><span class="n">i</span><span class="o">+</span><span class="n">j</span><span class="p">])</span>
                <span class="n">skip_gs</span> <span class="o">=</span> <span class="n">p_bm</span><span class="o">.</span><span class="n">good_suffix_rule</span><span class="p">(</span><span class="n">j</span><span class="p">)</span>
                <span class="n">shift</span> <span class="o">=</span> <span class="nb">max</span><span class="p">(</span><span class="n">shift</span><span class="p">,</span> <span class="n">skip_bc</span><span class="p">,</span> <span class="n">skip_gs</span><span class="p">)</span>
                <span class="n">mismatched</span> <span class="o">=</span> <span class="bp">True</span>
                <span class="k">break</span>
        <span class="k">if</span> <span class="ow">not</span> <span class="n">mismatched</span><span class="p">:</span>
            <span class="n">occurrences</span><span class="o">.</span><span class="n">append</span><span class="p">(</span><span class="n">i</span><span class="p">)</span>
            <span class="n">skip_gs</span> <span class="o">=</span> <span class="n">p_bm</span><span class="o">.</span><span class="n">match_skip</span><span class="p">()</span>
            <span class="n">shift</span> <span class="o">=</span> <span class="nb">max</span><span class="p">(</span><span class="n">shift</span><span class="p">,</span> <span class="n">skip_gs</span><span class="p">)</span>
        <span class="n">i</span> <span class="o">+=</span> <span class="n">shift</span>
    <span class="k">return</span> <span class="n">occurrences</span>
</pre></div>

</div>
</div>
</div>

</div>
