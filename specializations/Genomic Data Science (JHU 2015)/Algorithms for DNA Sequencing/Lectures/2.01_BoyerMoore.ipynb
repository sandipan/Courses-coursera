<div class=" highlight hl-ipython2"><pre><span class="n">t</span> <span class="o">=</span> <span class="s">&#39;GCTAGCTCTACGAGTCTA&#39;</span>
<span class="n">p</span> <span class="o">=</span> <span class="s">&#39;TCTA&#39;</span>
<span class="n">p_bm</span> <span class="o">=</span> <span class="n">BoyerMoore</span><span class="p">(</span><span class="n">p</span><span class="p">,</span> <span class="n">alphabet</span><span class="o">=</span><span class="s">&#39;ACGT&#39;</span><span class="p">)</span>
</pre></div>

</div>
</div>
</div>

</div>
