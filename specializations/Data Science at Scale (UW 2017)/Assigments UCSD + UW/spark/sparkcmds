import pyspark.sql.functions as func
orders.filter(orders["order_status"] == "COMPLETE").join(order_items, order_items.order_item_order_id == orders.order_id, "inner").groupBy('order_customer_id').agg(func.sum('order_item_subtotal').alias('cust_sum')).orderBy(desc('cust_sum')).show()
